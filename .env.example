# Copy to .env (git-ignored). Astro loads .env into the Airflow containers.
# All values are optional; the defaults below are what the code uses.

# Root of the date-partitioned file landing zone (raw/, processed/, quarantine/)
# LANDING_DIR=./landing

# DuckDB warehouse file written by the load DAG and read by dbt + the dashboard
# DUCKDB_PATH=./warehouse/fakeshop.duckdb

# dbt binary (set to the isolated venv in the Dockerfile)
# DBT_EXECUTABLE=dbt
